<?xml version="1.0" encoding="utf-8"?>
<!-- 无滚动：整页固定高度，中间空白用 weight 自适应 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fake_page_guofu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fake_guofu_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="@string/fake_guofu_logo"
            android:textColor="@color/fake_guofu_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="📍"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/fake_guofu_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/fake_guofu_greeting_afternoon"
        android:textColor="@color/fake_guofu_text"
        android:textSize="22sp" />

    <!-- 自适应空白：吃掉剩余高度；键盘弹出时由代码折叠 -->
    <View
        android:id="@+id/fake_guofu_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fake_guofu_card_bg"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/fake_guofu_username"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/fake_guofu_input_bg"
            android:hint="@string/fake_guofu_username"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/fake_guofu_text"
            android:textColorHint="@color/fake_guofu_muted"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/fake_guofu_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fake_guofu_input_bg"
                android:hint="@string/fake_guofu_password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="64dp"
                android:textColor="@color/fake_guofu_text"
                android:textColorHint="@color/fake_guofu_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/fake_guofu_show_btn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="@string/fake_guofu_show"
                android:textColor="@color/fake_guofu_show"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/fake_guofu_save_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/fake_guofu_save_check"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/fake_bank_checkbox" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/fake_guofu_save_user"
                    android:textColor="@color/fake_guofu_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fake_guofu_faceid_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/fake_guofu_faceid_check"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/fake_bank_checkbox" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/fake_guofu_faceid"
                    android:textColor="@color/fake_guofu_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/fake_guofu_enroll_btn"
                android:gravity="center"
                android:text="@string/fake_guofu_enroll"
                android:textColor="@color/fake_guofu_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fake_guofu_sign_btn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/fake_guofu_sign_disabled"
                android:clickable="true"
                android:enabled="false"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/fake_guofu_sign_on"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fake_guofu_passkey"
            android:textColor="@color/fake_guofu_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/fake_guofu_forgot"
            android:textColor="@color/fake_guofu_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fake_guofu_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/fake_guofu_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/fake_guofu_yellow_circle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fake_guofu_explore"
                android:textColor="@color/fake_guofu_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/fake_guofu_explore_link"
                android:textColor="@color/fake_guofu_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/fake_guofu_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/fake_guofu_yellow_circle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fake_guofu_points"
                android:textColor="@color/fake_guofu_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/fake_guofu_points_link"
                android:textColor="@color/fake_guofu_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
