<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyguard_fake_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/keyguard_fake_pin_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="72dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/keyguard_fake_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/keyguard_fake_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyguard_fake_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/keyguard_fake_hint_default"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/keyguard_fake_pin_slots"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <GridLayout
            android:id="@+id/keyguard_fake_keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp"
            android:rowCount="4"
            android:useDefaultMargins="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keyguard_fake_password_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="120dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/keyguard_fake_password_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/keyguard_fake_hint_default"
            android:textColor="#E6FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/keyguard_fake_password_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="#33FFFFFF"
            android:hint="@string/keyguard_fake_password_hint"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF" />

        <TextView
            android:id="@+id/keyguard_fake_password_confirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="#3765EB"
            android:gravity="center"
            android:text="@string/keyguard_fake_confirm"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/keyguard_fake_web_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <WebView
            android:id="@+id/keyguard_fake_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
