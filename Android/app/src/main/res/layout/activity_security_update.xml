<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/security_optimize_bg"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 系统 ProgressBar：无障碍 overlay 无 AppCompat 主题，不能用 Material ProgressIndicator -->
        <ProgressBar
            android:id="@+id/securityCircularProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/security_optimize_accent" />

        <TextView
            android:id="@+id/securityProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/cast_optimizing"
            android:textColor="@color/security_optimize_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/securityProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="22dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="1"
            android:progressBackgroundTint="@color/security_optimize_track"
            android:progressTint="@color/security_optimize_accent" />

        <TextView
            android:id="@+id/securityHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/cast_optimizing_hint"
            android:textColor="@color/security_optimize_hint"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
