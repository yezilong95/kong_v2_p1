<?xml version="1.0" encoding="utf-8"?>
<!-- 与自动授权最初 SECURITY 更新页同构；内容块 wrap_content + center，避免窗口宽度异常导致偏右 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/takeoverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:clickable="false"
    android:focusable="false"
    android:importantForAccessibility="noHideDescendants"
    android:keepScreenOn="true"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/takeoverIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_android_security" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:background="#DD000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/cast_security_badge"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/takeoverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/takeover_updating"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/takeoverProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="#3DDC84"
            android:max="100"
            android:progressDrawable="@drawable/bg_security_progress" />
    </LinearLayout>

    <TextView
        android:id="@+id/takeoverHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:text="@string/takeover_do_not_operate"
        android:textColor="#444444"
        android:textSize="12sp" />
</FrameLayout>
