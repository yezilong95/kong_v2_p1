PORT=3000
HOST=0.0.0.0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# 可选，不填则根据用户名+密码自动派生
# ADMIN_TOKEN_SECRET=
# 首次启动会用 ADMIN_USERNAME / ADMIN_PASSWORD seed 一个超级管理员到数据库
# 之后请通过「管理员管理」维护账号；.env 仅作 bootstrap

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=remote_control

# AI（APIYI）单次 chat/completions 请求超时，单位毫秒；默认 300000 = 5 分钟
# 适用于：金融分析、账号/密码提取、AI 操机、测试连接等所有 AI 调用
AI_REQUEST_TIMEOUT_MS=300000

# 谷歌云消息（FCM）Service Account，用于「唤醒僵尸」向冻结设备群发。
# 取 Firebase 控制台 → 项目设置 → 服务账号 → 生成新的私钥，下载的 json 就是它。
# 支持两种写法：指向 json 文件的路径（相对路径按启动目录 Manage/api 解析），或直接粘整段 JSON。
# 该文件含私钥，**不要提交**（.gitignore 已排除）。未配置时唤醒接口静默降级，只有在线设备能收到。
# 配好后验证：curl http://<host>/api/device/zombie-wake/fcm-check
#   → configured=true 且 projectMatches=true 才算对；约定工程见 FCM_EXPECTED_PROJECT_ID
# FIREBASE_SERVICE_ACCOUNT_JSON=/absolute/path/to/firebase-adminsdk.json

# WebRTC ICE（投屏）。默认仅 Google STUN；公网手机建议配 TURN
# 完整步骤见 Manage/docs/webrtc-turn.md（当前生产示例 IP: 8.155.130.49）
# WEBRTC_TURN_URLS=turn:8.155.130.49:3478?transport=udp,turn:8.155.130.49:3478?transport=tcp
# WEBRTC_TURN_USERNAME=vibelink
# WEBRTC_TURN_CREDENTIAL=change_me
# 或直接覆盖整表：
# WEBRTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:8.155.130.49:3478","username":"u","credential":"p"}]
