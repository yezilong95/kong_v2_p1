    <string name="media_projection_dialog_service_text_HONOR">Počas záznamu alebo vysielania môže služba poskytujúca túto funkciu zachytiť citlivé informácie zobrazené na obrazovke alebo prehrávané z vášho zariadenia, vrátane zvuku, hesiel, informácií o platbe, fotografií a správ.</string>
    <string name="media_projection_dialog_service_text_oppo">Služba poskytujúca túto funkciu bude mať prístup k všetkým informáciám zobrazovaným na obrazovke alebo prehrávaným v zariadení počas nahrávania či prenosu. Patria medzi ne informácie, akými sú napríklad heslá, platobné podrobnosti, fotky, správy a prehrávaný zvuk.</string>
    <string name="media_projection_dialog_service_title_oppo">Chcete začať nahrávanie alebo prenos?</string>
    <string name="media_projection_dialog_text_oppo">Povolenie %s bude mať prístup k všetkým informáciám zobrazovaným na obrazovke alebo prehrávaným v zariadení počas nahrávania či prenosu. Patria medzi ne informácie, akými sú napríklad heslá, platobné podrobnosti, fotky, správy a prehrávaný zvuk.</string>
    <string name="media_projection_dialog_title">Chcete spustiť nahrávanie alebo prenos s aktivovaným povolením %s?</string>
    <string name="media_projection_dialog_title_chn">Snímať, nahrávať alebo vysielať obrazovku pomocou aplikácie %s?</string>
    <string name="media_projection_dialog_title_oppo">Chcete spustiť nahrávanie alebo prenos s aktivovaným povolením %s?</string>
    <string name="media_projection_dialog_warning">%s bude mať prístup k všetkým informáciám zobrazovaným na obrazovke alebo prehrávaným v zariadení počas nahrávania či prenosu. Patria medzi ne informácie, ako sú heslá, platobné údaje, fotky, správy a prehrávaný zvuk.</string>
    <string name="media_projection_dialog_warning_chn">%s bude mať prístup ku všetkým informáciám, ktoré sú viditeľné na vašej obrazovke alebo prehrávané z vášho telefónu počas snímania, nahrávania alebo vysielania. To zahŕňa informácie ako heslá, platobné údaje, fotografie, správy a audionahrávky.</string>
    <string name="media_projection_entry_app_permission_dialog_title">Chcete spustiť nahrávanie alebo prenos s aktivovaným povolením %s?</string>
    <string name="media_projection_entry_app_permission_dialog_title_1">Chcete zdieľať obrazovku s aplikáciou %s?</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app">Počas zdieľania, nahrávania alebo prenosu v aplikácii bude mať %s prístup k všetkému, čo sa v danej aplikácii zobrazuje alebo prehráva. Preto zvýšte pozornosť v prípade položiek, ako sú heslá, platobné údaje, správy, fotky a zvuk či video.</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app_1">Pri zdieľaní aplikácie vidí aplikácia %s všetko, čo sa v zdieľanej aplikácii zobrazuje alebo prehráva. Preto zvýšte pozornosť v prípade položiek, ako sú heslá, platobné údaje, správy, fotky a zvuk či video.</string>
    <string name="media_record_projection_dialog_action_text_HONOR">Táto aplikácia môže zaznamenať alebo premietať celý obsah obrazovky. Na ochranu svojho súkromia sa vyhnite zadávaniu hesiel alebo otváraniu súkromných informácií, ako sú podrobnosti platby, správy a fotografie.</string>
