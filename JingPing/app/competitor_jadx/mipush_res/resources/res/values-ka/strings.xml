    <string name="media_projection_dialog_service_text_HONOR">ჩაწერის ან გადაცემის დროს, ამ ფუნქციის მომწოდებელ სერვისს შეუძლია დაიჭიროს ნებისმიერი სენსიტიური ინფორმაცია, რომელიც ჩნდება ეკრანზე ან ჩაირთვება მოწყობილობაში, მათ შორის აუდიო, პაროლები, გადახდის ინფორმაცია, ფოტოები და შეტყობინებები.</string>
    <string name="media_projection_dialog_service_text_oppo">ამ ფუნქციის მომწოდებელ სერვისს ექნება წვდომა ყველა ინფორმაციაზე, რომელიც თქვენს ეკრანზე გამოჩნდება ან თქვენს მოწყობილობაზე დაიკვრება ჩაწერის ან ტრანსლირების განმავლობაში. აღნიშნული მოიცავს ისეთ ინფორმაციას, როგორიც არის პაროლები, გადახდის დეტალები, ფოტოები, შეტყობინებები და თქვენ მიერ დაკრული აუდიო.</string>
    <string name="media_projection_dialog_service_title_oppo">დაიწყოს ჩაწერა ან ტრანსლირება?</string>
    <string name="media_projection_dialog_text_oppo">%s-ს ექნება წვდომა ყველა ინფორმაციაზე, რომელიც თქვენს ეკრანზე გამოჩნდება ან თქვენს მოწყობილობაზე დაიკვრება ჩაწერის ან ტრანსლირების განმავლობაში. აღნიშნული მოიცავს ისეთ ინფორმაციას, როგორიც არის პაროლები, გადახდის დეტალები, ფოტოები, შეტყობინებები და თქვენ მიერ დაკრული აუდიო.</string>
    <string name="media_projection_dialog_title">დაიწყოს ჩაწერა ან ტრანსლირება %s-ით?</string>
