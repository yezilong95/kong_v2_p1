    <string name="media_projection_dialog_service_text_HONOR">Under optagelse eller casting kan tjenesten, som leverer denne funktion, registrere alle følsomme oplysninger, som vises på din skærm eller afspilles fra din enhed, herunder lyd, adgangskoder, betalingsoplysninger, fotos og beskeder.</string>
    <string name="media_projection_dialog_service_text_oppo">Tjenesten, der tilbyder denne funktion, får adgang til alle de oplysninger, der er synlige på din skærm, eller som afspilles på din enhed, når du optager eller caster. Dette omfatter oplysninger som f.eks. adgangskoder, betalingsoplysninger, billeder, beskeder og afspillet lyd.</string>
    <string name="media_projection_dialog_service_title_oppo">Vil du begynde at optage eller caste?</string>
    <string name="media_projection_dialog_text_oppo">%s får adgang til alle de oplysninger, der er synlige på din skærm, eller som afspilles på din enhed, når du optager eller caster. Dette omfatter oplysninger som f.eks. adgangskoder, betalingsoplysninger, billeder, beskeder og afspillet lyd.</string>
    <string name="media_projection_dialog_title">Vil du begynde at optage eller caste via %s?</string>
    <string name="media_projection_dialog_title_chn">Vil du tage billede, optage eller caste skærmen med %s?</string>
    <string name="media_projection_dialog_title_oppo">Vil du begynde at optage eller caste via %s?</string>
    <string name="media_projection_dialog_warning">%s får adgang til alle de oplysninger, der er synlige på din skærm, eller som afspilles på din enhed, når du optager eller caster. Dette omfatter oplysninger som f.eks. adgangskoder, betalingsoplysninger, billeder, beskeder og afspillet lyd.</string>
    <string name="media_projection_dialog_warning_chn">%s har adgang til alle de oplysninger, der er synlige på din skærm eller afspilles fra din telefon under fotografering, optagelse eller casting. Dette omfatter oplysninger som adgangskoder, betalingsoplysninger, billeder, beskeder og lyd.</string>
    <string name="media_projection_entry_app_permission_dialog_title">Vil du begynde at optage eller caste via %s?</string>
    <string name="media_projection_entry_app_permission_dialog_title_1">Vil du dele din skærm med %s?</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app">Når du deler, optager eller caster en app, har %s adgang til alt, der vises eller afspilles i den pågældende app. Vær derfor forsigtig med ting såsom adgangskoder, betalingsoplysninger, beskeder, billeder, lyd og video.</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app_1">Når du deler en app, er alt, der vises eller afspilles i den pågældende app, synligt for %s. Vær derfor forsigtig med f.eks. adgangskoder, betalingsoplysninger, beskeder, billeder, lyd og video.</string>
    <string name="media_record_projection_dialog_action_text_HONOR">Denne app vil optage eller projicere alt på skærmen. For at beskytte dine personlige oplysninger bør du ikke indtaste adgangskoder eller åbne private oplysninger som for eksempel betalingsoplysninger, beskeder og fotos.</string>
    <string name="media_record_projection_dialog_title_HONOR">Tillad, at \"%s\" optager/projicerer skærmen?</string>
