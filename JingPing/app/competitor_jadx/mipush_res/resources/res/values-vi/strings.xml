    <string name="media_projection_entry_app_permission_dialog_warning_single_app">\"%s\" sẽ có quyền truy cập vào bất kỳ nội dung nào hiển thị trong hoặc phát từ ứng dụng hiện tại.</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app_1">Khi bạn chia sẻ một ứng dụng, %s sẽ thấy được mọi nội dung hiển thị hoặc phát trong ứng dụng đó. Vì vậy, hãy thận trọng để không làm lộ thông tin như mật khẩu, thông tin thanh toán, tin nhắn, ảnh, âm thanh và video.</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app_expregion">\"%s\" sẽ có quyền truy cập vào bất kỳ nội dung nào hiển thị trong hoặc phát từ ứng dụng hiện tại.</string>
