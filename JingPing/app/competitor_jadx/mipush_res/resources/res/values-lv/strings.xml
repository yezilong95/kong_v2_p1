    <string name="media_projection_dialog_service_text_HONOR">Ierakstīšanas vai apraides laikā pakalpojums, kas nodrošina šo funkciju, var ierakstīt sensitīvu informāciju, kas tiek attēlota jūsu ekrānā vai atskaņota no jūsu ierīces, tostarp audio, paroles, maksājumu informāciju, fotoattēlus un ziņojumus.</string>
    <string name="media_projection_dialog_service_text_oppo">Pakalpojums, kas nodrošina šo funkciju, iegūs piekļuvi visai informācijai, kas ierakstīšanas vai apraides laikā tiks rādīta jūsu ekrānā vai atskaņota jūsu ierīcē. Atļauja attiecas uz tādu informāciju kā paroles, maksājumu informācija, fotoattēli, ziņojumi un jūsu atskaņotais audio saturs.</string>
    <string name="media_projection_dialog_service_title_oppo">Vai vēlaties sākt ierakstīšanu/apraidi?</string>
    <string name="media_projection_dialog_text_oppo">%s iegūs piekļuvi visai informācijai, kas ierakstīšanas vai apraides laikā tiks rādīta jūsu ekrānā vai atskaņota jūsu ierīcē. Atļauja attiecas uz tādu informāciju kā paroles, maksājumu informācija, fotoattēli, ziņojumi un jūsu atskaņotais audio saturs.</string>
    <string name="media_projection_dialog_title">Vai vēlaties sākt ierakstīšanu vai apraidi, izmantojot lietotni %s?</string>
    <string name="media_projection_dialog_title_chn">Vai uzņemt, ierakstīt vai apraidīt ekrānu, izmantojot %s?</string>
    <string name="media_projection_dialog_title_oppo">Vai vēlaties sākt ierakstīšanu vai apraidi, izmantojot lietotni %s?</string>
    <string name="media_projection_dialog_warning">%s iegūs piekļuvi visai informācijai, kas ierakstīšanas vai apraides laikā tiks rādīta jūsu ekrānā vai atskaņota jūsu ierīcē. Atļauja attiecas uz tādu informāciju kā paroles, maksājumu informācija, fotoattēli, ziņojumi un jūsu atskaņotais audio saturs.</string>
    <string name="media_projection_dialog_warning_chn">%s varēs piekļūt visai informācijai, kas ir redzama jūsu ekrānā vai tiek atskaņota no jūsu tālruņa tveršanas, ierakstīšanas vai apraides laikā. Tas ietver tādu informāciju kā paroles, maksājumu datus, attēlus, ziņas un audio failus.</string>
    <string name="media_projection_entry_app_permission_dialog_title">Vai vēlaties sākt ierakstīšanu vai apraidi, izmantojot lietotni %s?</string>
    <string name="media_projection_entry_app_permission_dialog_title_1">Vai kopīgot ekrānu ar lietotni %s?</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app">Lietotnes kopīgošanas, ierakstīšanas vai apraides laikā %s var piekļūt visam, kas tiek rādīts vai atskaņots attiecīgajā lietotnē. Tāpēc piesardzīgi apejieties ar parolēm, maksājumu informāciju, ziņojumiem, fotoattēliem un audio un video saturu.</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app_1">Kopīgojot lietotni, lietotnei %s ir pieejams viss kopīgotajā lietotnē parādītais vai atskaņotais saturs. Tāpēc piesardzīgi apejieties ar parolēm, maksājumu informāciju, ziņojumiem, fotoattēliem un audio un video saturu.</string>
    <string name="media_record_projection_dialog_action_text_HONOR">Šī lietotne ierakstīs vai projicēs visu ekrānā redzamo saturu. Lai aizsargātu savu konfidencialitāti, neievadiet paroles un neatveriet privātu informāciju, piemēram, maksājumu informāciju, ziņojumus un fotoattēlus.</string>
    <string name="media_record_projection_dialog_title_HONOR">Vai atļaut “%s” ierakstīt/projicēt ekrānu?</string>
