    <string name="media_projection_dialog_service_text_HONOR">Grabatzen edo igortzen ari den bitartean, eginbidea ematen duen zerbitzuak pantailan bistaratu edo gailutik erreproduzitu den informazio garrantzitsua kaptura dezake, audioak, pasahitzak, ordainketa-informazioa, argazkiak eta mezuak barne.</string>
    <string name="media_projection_dialog_service_text_oppo">Zerbait grabatzen edo igortzen duzunean, pantailan ikus daitekeen edo gailuak erreproduzitzen duen informazio guztia atzitu ahalko du funtzio hori eskaintzen duen zerbitzuak; besteak beste, pasahitzak, ordainketen xehetasunak, argazkiak, mezuak eta erreproduzitzen dituzun audioak.</string>
    <string name="media_projection_dialog_service_title_oppo">Grabatzen edo igortzen hasi nahi duzu?</string>
    <string name="media_projection_dialog_text_oppo">Zerbait grabatzen edo igortzen duzunean, pantailan ikus daitekeen edo gailuak erreproduzitzen duen informazio guztia atzitu ahalko du %s aplikazioak; besteak beste, pasahitzak, ordainketen xehetasunak, argazkiak, mezuak eta erreproduzitzen dituzun audioak.</string>
    <string name="media_projection_dialog_title">%s aplikazioarekin grabatzen edo igortzen hasi nahi duzu?</string>
    <string name="media_projection_dialog_title_oppo">%s aplikazioarekin grabatzen edo igortzen hasi nahi duzu?</string>
    <string name="media_projection_dialog_warning">Zerbait grabatzen edo igortzen duzunean, pantailan ikusgai dagoen edo gailuak erreproduzitzen duen informazio guztia atzi dezake %s aplikazioak. Pasahitzak, ordainketen xehetasunak, argazkiak, mezuak eta erreproduzitzen dituzun audioak sartzen dira informazio horretan.</string>
    <string name="media_projection_entry_app_permission_dialog_title">%s aplikazioarekin grabatzen edo igortzen hasi nahi duzu?</string>
    <string name="media_projection_entry_app_permission_dialog_title_1">%s aplikazioarekin pantaila partekatu nahi duzu?</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app">Aplikazio bat partekatzen, grabatzen edo igortzen ari zarenean, aplikazio horretan ikusgai dagoen edo bertan erreproduzitzen ari den guztia atzi dezake %s aplikazioak. Beraz, kontuz ibili pasahitzekin, ordainketen xehetasunekin, mezuekin, argazkiekin, audioekin eta bideoekin, besteak beste.</string>
    <string name="media_projection_entry_app_permission_dialog_warning_single_app_1">Aplikazio bat partekatzen ari zarenean, aplikazio horretan agertzen den edo bertan erreproduzitzen ari den guztia ikusi dezake %s aplikazioak. Beraz, kontuz ibili pasahitzekin, ordainketen xehetasunekin, mezuekin, argazkiekin, audioekin eta bideoekin, besteak beste.</string>
    <string name="media_record_projection_dialog_action_text_HONOR">Aplikazioak pantailan dagoen guztia grabatu edo proiektatuko du. Pribatutasuna babesteko, ez idatzi pasahitzik edo informazio pribaturik, hala nola ordainketa-xehetasunak, mezuak eta argazkiak.</string>
    <string name="media_record_projection_dialog_title_HONOR">\"%s\" aplikazioari baimena eman nahi diozu pantaila grabatu edo proiektatzeko?</string>
