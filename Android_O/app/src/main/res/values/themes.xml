<resources>
    <style name="Theme.Installer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryVariant">@android:color/white</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/home_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/home_bg</item>
        <item name="android:windowBackground">@color/home_bg</item>
    </style>

    <style name="Theme.Installer.PlayUpdate" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/play_update_button</item>
        <item name="colorPrimaryVariant">@color/play_update_button</item>
        <item name="colorOnPrimary">@color/play_bg</item>
        <item name="android:statusBarColor">@color/play_bg</item>
        <item name="android:navigationBarColor">@color/play_bg</item>
        <item name="android:windowBackground">@color/play_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
