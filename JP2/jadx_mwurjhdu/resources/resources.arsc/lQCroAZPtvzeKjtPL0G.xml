<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.AlertDialogLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|top"
    android:orientation="vertical"
    android:id="@attr/parentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/mtrl_alert_dialog_title"/>
    <FrameLayout
        android:id="@attr/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <View
            android:layout_gravity="top"
            android:id="@attr/scrollIndicatorUp"
            android:background="?style/colorControlHighlight"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@attr/scrollView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <android.widget.Space
                    android:id="@attr/textSpacerNoTitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/abc_dialog_padding_top_material"/>
                <TextView
                    android:id="@android:id/message"
                    android:paddingLeft="?style/dialogPreferredPadding"
                    android:paddingRight="?style/dialogPreferredPadding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="?style/materialAlertDialogBodyTextStyle"/>
                <android.widget.Space
                    android:id="@attr/textSpacerNoButtons"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/abc_dialog_padding_top_material"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:layout_gravity="bottom"
            android:id="@attr/scrollIndicatorDown"
            android:background="?style/colorControlHighlight"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@attr/customPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <FrameLayout
            android:id="@attr/custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/mtrl_alert_dialog_actions"/>
</androidx.appcompat.widget.AlertDialogLayout>
