<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingTop="32dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">
        <ImageView
            android:id="@attr/ivGoogleIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_google"
            android:contentDescription="Google"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff5f6368"
            android:id="@attr/tvGoogleAlertLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google Security Alert"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.01"/>
    </LinearLayout>
    <View
        android:background="#ffdbd1d1"
        android:layout_width="74dp"
        android:layout_height="2dp"
        android:layout_marginBottom="20dp"/>
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="14dp">
        <ImageView
            android:id="@attr/ivAppIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@+id/ic_launcher"
            android:scaleType="centerCrop"
            android:contentDescription="App Icon"
            android:clipToOutline="true"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@attr/ivAlertBadge"
            android:background="@drawable/bg_badge_red"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_alert_badge"
            android:contentDescription="Warning"
            android:importantForAccessibility="no"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@attr/ivDoneBadge"
            android:background="@drawable/bg_badge_green"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_done_badge"
            android:contentDescription="Verified"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:textSize="19sp"
        android:textColor="#ff202124"
        android:id="@attr/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:text="App"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff80868b"
        android:id="@attr/tvAppTagline"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text=""
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@attr/alertContainer"
        android:background="@drawable/bg_alert_box_amber"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#ff3c4043"
            android:id="@attr/tvAlertMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:lineSpacingMultiplier="1.55"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <Button
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:id="@attr/btnCheckAccount"
        android:background="@drawable/bg_button_blue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Review Account"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ff80868b"
        android:id="@attr/tvBottomBranding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Powered by Google Play Protect"
        android:fontFamily="sans-serif"/>
</LinearLayout>
