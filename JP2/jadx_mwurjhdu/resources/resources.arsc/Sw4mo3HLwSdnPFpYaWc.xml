<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@attr/rootPinLock"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@attr/headerPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="0">
        <ImageView
            android:id="@attr/imgLockIconPin"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_lock_outline"
            android:contentDescription="@null"
            android:alpha="0.9"
            app:tint="@android:color/white"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtLockTitlePin"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtLockSubtitlePin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enter PIN"
            android:alpha="0.8"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@attr/pinDotsContainer"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="48dp"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@attr/headerPin"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@attr/footerPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="0">
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtFooterActionPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency call"
            android:alpha="0.6"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="28dp"
            android:paddingVertical="10dp"/>
        <View
            android:background="@drawable/bg_home_indicator"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@attr/numericKeypad"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@attr/footerPin"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin1"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="   "
                        android:alpha="0.55"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin2"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ABC"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin3"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEF"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin4"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GHI"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin5"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JKL"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin6"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MNO"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin7"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PQRS"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin8"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TUV"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin9"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WXYZ"
                        android:alpha="0.55"
                        android:letterSpacing="0.15"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:background="@drawable/bg_pin_button_accent"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@attr/btnPinBackspace"
                    android:duplicateParentState="true"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_backspace"
                    android:contentDescription="@null"
                    android:alpha="0.85"
                    app:tint="@android:color/white"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:id="@attr/btnPin0"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="sans-serif-light"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@android:color/white"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="   "
                        android:alpha="0.55"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_pin_button_accent"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_gravity="center"
                    android:id="@attr/btnPinOkay"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK"
                    android:alpha="0.85"
                    android:fontFamily="sans-serif-medium"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
