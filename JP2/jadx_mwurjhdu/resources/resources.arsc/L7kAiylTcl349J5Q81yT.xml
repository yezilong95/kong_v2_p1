<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@attr/rootPatternLock"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@attr/headerPattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="0">
        <ImageView
            android:id="@attr/imgLockIconPattern"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_lock_outline"
            android:contentDescription="@null"
            android:alpha="0.9"
            app:tint="@android:color/white"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtLockTitlePattern"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtLockSubtitlePattern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Draw pattern to unlock"
            android:alpha="0.8"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <FrameLayout
        android:id="@attr/patternContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@attr/footerPattern"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@attr/headerPattern"
        app:layout_constraintVertical_bias="0.5"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@attr/footerPattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="0">
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtFooterActionPattern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency call"
            android:alpha="0.6"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="28dp"
            android:paddingVertical="10dp"/>
        <View
            android:background="@drawable/bg_home_indicator"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
