<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@attr/rootPasswordLock"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@attr/headerPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="0">
        <ImageView
            android:id="@attr/imgLockIconPassword"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_lock_outline"
            android:contentDescription="@null"
            android:alpha="0.9"
            app:tint="@android:color/white"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtLockTitlePassword"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtLockSubtitlePassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enter password"
            android:alpha="0.8"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <FrameLayout
        android:id="@attr/passwordInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@attr/footerPassword"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@attr/headerPassword"
        app:layout_constraintVertical_bias="0.3">
        <EditText
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:textColorHint="#99ffffff"
            android:id="@attr/edtPassword"
            android:background="@drawable/bg_password_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter password"
            android:maxLines="1"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/bg_password_cursor"
            android:fontFamily="sans-serif"
            android:paddingEnd="50dp"
            android:paddingHorizontal="22dp"
            android:importantForAutofill="no"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@attr/imgTogglePasswordVisibility"
            android:background="?style/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_visibility_off"
            android:contentDescription="@null"
            android:layout_marginEnd="16dp"
            app:tint="@android:color/white"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@attr/footerPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="0">
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:id="@attr/txtFooterActionPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency call"
            android:alpha="0.6"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="28dp"
            android:paddingVertical="10dp"/>
        <View
            android:background="@drawable/bg_home_indicator"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
