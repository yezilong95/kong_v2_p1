<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:color="?style/colorOnSurface"
        android:alpha="@dimen/m3_comp_switch_disabled_unselected_handle_opacity"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:color="?style/colorSurface"
        android:alpha="@dimen/m3_comp_switch_disabled_selected_handle_opacity"/>
    <item
        android:state_checked="true"
        android:state_pressed="true"
        android:color="?style/colorPrimaryContainer"/>
    <item
        android:state_checked="true"
        android:color="?style/colorOnPrimary"/>
    <item
        android:state_pressed="true"
        android:color="?style/colorOnSurfaceVariant"/>
    <item android:color="?style/colorOutline"/>
</selector>
