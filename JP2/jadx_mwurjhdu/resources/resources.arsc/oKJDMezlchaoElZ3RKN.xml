<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.AlertDialogLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|top"
    android:orientation="vertical"
    android:id="@attr/parentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/abc_alert_dialog_title_material"/>
    <FrameLayout
        android:id="@attr/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <ImageView
            android:layout_gravity="top"
            android:id="@attr/scrollIndicatorUp"
            android:background="#1f000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:backgroundTint="?android:attr/colorForeground"/>
        <androidx.core.widget.NestedScrollView
            android:id="@attr/scrollView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <android.widget.Space
                    android:id="@attr/textSpacerNoTitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/abc_dialog_padding_top_material"/>
                <TextView
                    android:id="@android:id/message"
                    android:paddingLeft="?style/dialogPreferredPadding"
                    android:paddingRight="?style/dialogPreferredPadding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@plurals/TextAppearance.AppCompat.Subhead"/>
                <android.widget.Space
                    android:id="@attr/textSpacerNoButtons"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/abc_dialog_padding_top_material"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@attr/scrollIndicatorDown"
            android:background="#1f000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:backgroundTint="?android:attr/colorForeground"/>
    </FrameLayout>
    <FrameLayout
        android:id="@attr/customPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <FrameLayout
            android:id="@attr/custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/abc_alert_dialog_button_bar_material"/>
</androidx.appcompat.widget.AlertDialogLayout>
